{
  "$schema": "https://charm.land/crush.json",
  "providers": {
    "anthropic": {
      "api_key": "$(pass datadog/anthropic)"
    }
  },
  "models": {
    "large": {
      "model": "claude-sonnet-5-5",
      "provider": "anthropic",
      "think": true,
      "max_tokens": 128000
    }
  },
  "lsp": {
    "python": {
      "command": "pylsp",
      "filetypes": [
        "python"
      ]
    },
    "typescript": {
      "command": "typescript-language-server",
      "args": [
        "--stdio"
      ],
      "filetypes": [
        "javascript",
        "javascriptreact",
        "typescript",
        "typescriptreact"
      ],
      "init_options": {
        "maxTsServerMemory": 16384,
        "tsserver": {
          "path": "$HOME/opt/node/lib/node_modules/typescript/lib/"
        }
      }
    },
    "terraform": {
      "command": "terraform-ls",
      "args": [
        "serve"
      ],
      "filetypes": [
        "terraform"
      ]
    }
  },
  "options": {
    "disable_metrics": true,
    "skills_paths": [
      "~/.config/skills/"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^bash$",
        "command": "${HOME}/.config/crush/hooks/bash-policy.sh"
      }
    ]
  }
}
