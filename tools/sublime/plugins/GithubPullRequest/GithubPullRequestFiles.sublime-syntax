%YAML 1.2
---
# Colors the GithubPullRequest "changed files" bottom panel. Every hue below is DISTINCT in
# Mariana (the scheme this is tuned for), so nothing reads as a duplicate:
#   PR header          entity.name.class  orange  hsl(32,93%,66%)
#   +N additions       markup.inserted    green   hsl(114,31%,68%)
#   -M deletions       markup.deleted     red     hsl(357,79%,65%)
#   (K unresolved)     support.type       blue    hsl(210,50%,60%)
#   (P pending)        comment            grey    hsl(221,12%,69%)
#   CODEOWNERS         support.constant   mauve   hsl(300,30%,68%)
#   visited row        comment.open-file  grey    (dimmed by inheritance, see below)
# Mariana has no further distinct hue reachable by a scope: `orange3` is a true yellow but
# no rule maps to it. All of the above are foreground-only, so there is no background fill
# (unlike region.*ish, and unlike `invalid` / `markup.raw` / `diff.inserted`, which DO set
# one — never use those here). Every row begins with a fixed-width marker slot
# ("● " when open, two spaces when not; see panel._OPEN_MARKER) — a syntax can only assign
# scopes by matching TEXT, so a real character is needed. The `+N -M` rule is therefore not
# `^`-anchored and instead requires the whole pair plus a trailing space, so hyphens inside
# file paths (in the trailing "path:line") are never miscolored.
hidden: true
scope: source.githubpullrequest-files
contexts:
  main:
    # Anchored on the real header shape (`PR #<n> ·`), not a bare "PR #", so a
    # description line that happens to mention another PR is not painted as a header.
    - match: '^PR #\d+ ·.*$'
      scope: entity.name.class.githubpullrequest-files
    # Rows for a file that is open as a tab, detected by the leading marker. Pushing a
    # context is what lets the row's `path:line` token go grey too, while the shared token
    # rules still color stats, counts and owners. The grey comes from staying under
    # `comment.` — every color scheme renders that dimmed — so a file already visited
    # recedes instead of competing with the colors that carry the real signal. No
    # color-scheme override is needed.
    # The lookahead keeps a description line that merely starts with a bullet from being
    # treated as a row: a real row always continues with " +" (file) or "  " (counts).
    - match: '^●(?= [+ ])'
      scope: comment.open-file.githubpullrequest-files
      push: open_row
    - include: row_tokens

  open_row:
    - match: $\n?
      pop: true
    - match: '\S+:\d+'
      scope: comment.open-file.githubpullrequest-files
    - include: row_tokens

  row_tokens:
    # The pair (and the space after it) only ever occurs as a file row's leading token,
    # so this cannot match a hyphen inside a path.
    - match: '(\+\d+)\s+(-\d+)(?=\s)'
      captures:
        1: markup.inserted.githubpullrequest-files
        2: markup.deleted.githubpullrequest-files
    - match: '\(\d+ unresolved\)'
      scope: support.type.githubpullrequest-files
    - match: '\(\d+ pending\)'
      scope: comment.githubpullrequest-files
    # CODEOWNERS handles / emails (the only @-bearing tokens on a row) -> mauve.
    - match: '\S*@\S+'
      scope: support.constant.githubpullrequest-files
